# 32-byte hex key for encrypting credentials in crosspoint.db
# Generate with: openssl rand -hex 32
TOKEN_ENC_KEY=your_32_byte_hex_key_here

# Host port mapping for CrossPoint sync server
PORT=8088

# Storage path for SQLite database
APP_DATA_DIR=/mnt/user/appdata/crosspoint-sync/data

# Docker network to attach to (needs access to bookorbit-db if auto-indexing)
DOCKER_NETWORK=proxy

# Readwise API rate limit cooldown in milliseconds (default: 10000ms)
READWISE_RATE_COOLDOWN_MS=10000

# Minimum fuzzy match score threshold (0.0 to 1.0, default: 0.7)
READWISE_MATCH_THRESHOLD=0.7
